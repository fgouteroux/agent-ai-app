{
  "name": "agent-ai-app",
  "version": "1.0.0",
  "description": "AI assistant for Grafana -- answers questions about your dashboards, metrics, logs, and traces using live data, with customizable specialist agents.",
  "repository": {
    "type": "git",
    "url": "https://github.com/luiscorreiaops/agent-ai-app.git"
  },
  "scripts": {
    "build": "webpack -c ./webpack.config.ts --env production",
    "dev": "webpack -w -c ./webpack.config.ts --env development",
    "test": "jest --passWithNoTests",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache ./src",
    "lint:fix": "eslint --cache --fix --ext .js,.jsx,.ts,.tsx ./src",
    "backend:build": "mage -v",
    "server": "docker compose up --build",
    "sign": "npx --yes @grafana/sign-plugin@latest"
  },
  "author": "Luis Correia",
  "license": "MIT",
  "devDependencies": {
    "@grafana/eslint-config": "^10.0.0",
    "@grafana/sign-plugin": "^3.3.3",
    "@grafana/tsconfig": "^2.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/core": "^1.11.0",
    "@swc/jest": "^0.2.37",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "copy-webpack-plugin": "^12.0.0",
    "css-loader": "^7.1.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fork-ts-checker-webpack-plugin": "^9.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "puppeteer": "^24.40.0",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.6",
    "ts-node": "^10.9.0",
    "typescript": "^5.7.0",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.0",
    "webpack-livereload-plugin": "^3.0.0"
  },
  "dependencies": {
    "@emotion/css": "^11.13.0",
    "@grafana/data": "^12.3.0",
    "@grafana/runtime": "^12.3.0",
    "@grafana/ui": "^12.3.0",
    "mermaid": "^11.16.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.7",
  "overrides": {
    "dompurify": "^3.4.12"
  },
  "trustedDependencies": [
    "@swc/core"
  ]
}
